{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Public commercial profile and credit line state for an authenticated merchant.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "initials": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "businessName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "businessType": {
          "type": "string",
          "enum": [
            "Bodega de Barrio",
            "Abasto / Charcutería",
            "Revendedor / Ruta",
            "Mini Frigorífico"
          ]
        },
        "zone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "coldChain": {
          "type": "string",
          "enum": [
            "Cava cuarto propia",
            "Congelador horizontal / vitrina",
            "Venta diaria con hielo / rotación 24h"
          ]
        },
        "points": {
          "type": "number"
        },
        "tierName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "creditLimit": {
          "type": "number"
        },
        "referralCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "firstName",
        "initials",
        "businessName",
        "businessType",
        "zone",
        "coldChain",
        "points",
        "tierName",
        "creditLimit",
        "referralCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document containing applicant identification and contact details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "dni": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 220
        },
        "seniority": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "dni",
        "address",
        "seniority",
        "phone",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreditApplication": {
      "title": "CreditApplication",
      "description": "Poultry, pork, or cold-chain credit application and installment schedule.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contractCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["avicola", "porcicola", "mixto", "capital"]
        },
        "supplierId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "supplierName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "zone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 220
        },
        "totalAmount": {
          "type": "number"
        },
        "initialPaid": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "remainingAmount": {
          "type": "number"
        },
        "totalInstallments": {
          "type": "number"
        },
        "paidInstallments": {
          "type": "number"
        },
        "nextDueDate": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"]
        },
        "approvalStatus": {
          "type": "string",
          "enum": ["aprobado", "en_revision"]
        },
        "coldChainInsured": {
          "type": "boolean"
        },
        "dispatchCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "createdAtLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "installments": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "contractCode",
        "title",
        "subtitle",
        "category",
        "supplierId",
        "supplierName",
        "zone",
        "totalAmount",
        "initialPaid",
        "paidAmount",
        "remainingAmount",
        "totalInstallments",
        "paidInstallments",
        "nextDueDate",
        "status",
        "coldChainInsured",
        "dispatchCode",
        "createdAtLabel",
        "installments",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserCoupon": {
      "title": "UserCoupon",
      "description": "Discount coupon attached to a merchant account.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 220
        },
        "discountAmount": {
          "type": "number"
        },
        "categoryFilter": {
          "type": "string",
          "enum": ["avicola", "porcicola", "mixto", "capital", "all"]
        },
        "expiresAt": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["available", "used", "expired"]
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "description",
        "discountAmount",
        "categoryFilter",
        "expiresAt",
        "status",
        "code",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Merchant commercial account and credit line settings."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document for the merchant."
    },
    "/users/{userId}/credits/{creditId}": {
      "schema": { "$ref": "#/entities/CreditApplication" },
      "description": "Credit applications and active/completed loans owned by the merchant."
    },
    "/users/{userId}/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/UserCoupon" },
      "description": "Merchant discount coupons."
    }
  }
}
